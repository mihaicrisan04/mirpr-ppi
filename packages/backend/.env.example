# IMPORTANT: Use "local" AI with self-hosted Convex, "openai" with cloud Convex
AI_PROVIDER=local  # "openai" | "local"


# ─────────────────────────────────────────────────────────────────────────────
# CLOUD DEPLOYMENT (uncomment when using Convex cloud + OpenAI)
# ─────────────────────────────────────────────────────────────────────────────
# CONVEX_DEPLOYMENT=dev:curious-bat-123
# CONVEX_URL=https://curious-bat-123.convex.cloud
# OPENAI_API_KEY=sk-proj-...
# OPENAI_EMBEDDING_DIMENSION=1536


# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEPLOYMENT (uncomment when using self-hosted Convex + local AI)
# ─────────────────────────────────────────────────────────────────────────────
# CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
# CONVEX_SELF_HOSTED_ADMIN_KEY=convex-self-hosted|...
# CONVEX_URL=http://127.0.0.1:3210
# LOCAL_AI_BASE_URL=http://host.docker.internal:8001
# LOCAL_EMBEDDING_DIMENSION=768


# ─────────────────────────────────────────────────────────────────────────────
# SHARED (required for both)
# ─────────────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=$(openssl rand -base64 32)
RESEND_API_KEY=
SITE_URL=http://localhost:3001
